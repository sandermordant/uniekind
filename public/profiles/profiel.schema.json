{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniekind.local/schema/profiel.schema.json",
  "title": "Uniekind schoolprofiel",
  "type": "object",
  "required": ["profielVersie", "id", "school", "uniekind", "huisstijl", "motto", "kernwaarden", "pijlers", "principes", "afdelingen", "vakken", "ruimtes", "regels", "didactiek", "generator", "terminologie"],
  "properties": {
    "profielVersie": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "school": {
      "type": "object", "required": ["naam"],
      "properties": { "naam": { "type": "string", "minLength": 1 } }
    },
    "uniekind": {
      "type": "object", "required": ["titel", "ondertitel", "noindex"],
      "properties": {
        "titel": { "type": "string" },
        "ondertitel": { "type": "string" },
        "noindex": { "type": "boolean" },
        "toegangscode": { "type": ["string", "null"] }
      }
    },
    "huisstijl": {
      "type": "object", "required": ["kleuren", "lettertype"],
      "properties": {
        "logo": { "type": ["string", "null"] },
        "kleuren": {
          "type": "object", "required": ["hoofd"],
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "lettertype": { "type": "string" }
      }
    },
    "motto": { "type": "object", "required": ["tekst"] },
    "kernwaarden": { "type": "array", "items": { "type": "string" } },
    "pijlers": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "naam", "omschrijving"] }
    },
    "principes": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "naam", "uniekind", "regel"] }
    },
    "afdelingen": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "naam", "niveau", "leerjaren", "lesduren", "standaardLesduur"],
        "properties": {
          "niveau": { "enum": ["vmbo", "havo", "vwo"] },
          "leerjaren": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 6 } },
          "lesduren": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 20, "maximum": 240 } },
          "standaardLesduur": { "type": "integer", "minimum": 20, "maximum": 240 }
        }
      }
    },
    "vakken": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "naam", "afdelingen", "rekenen"],
        "properties": {
          "afdelingen": { "oneOf": [{ "const": "alle" }, { "type": "array", "items": { "type": "string" } }] },
          "rekenen": { "type": "boolean" }
        }
      }
    },
    "ruimtes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "naam", "capaciteit"],
        "properties": { "capaciteit": { "type": ["integer", "null"], "minimum": 1 } }
      }
    },
    "regels": {
      "type": "object", "required": ["telefoon"],
      "properties": {
        "telefoon": { "type": "object", "required": ["toegestaan"], "properties": { "toegestaan": { "type": "boolean" } } }
      }
    },
    "didactiek": {
      "type": "object", "required": ["taxonomie", "lesmodel"],
      "properties": {
        "taxonomie": { "enum": ["bloom", "rtti"] },
        "lesmodel": { "enum": ["di", "adi", "edi", "igdi", "eigen"] }
      }
    },
    "generator": {
      "type": "object", "required": ["gewichten", "beweegmomentElkeMinuten", "instructieMaxMlokaal"],
      "properties": {
        "gewichten": {
          "type": "object",
          "required": ["denkniveau", "lesfase", "docentstijl", "klas", "visie", "variatie", "ervaring"]
        }
      }
    },
    "terminologie": { "type": "object" }
  }
}
